# Axiom-EMS environment variables
# Copy this file to .env and fill in your values.
# Never commit .env — it is listed in .gitignore.

# ── Supabase (optional) ─────────────────────────────────────────────────────
# When these are set, the Officer and Driver views communicate with the Control
# Room over Supabase Realtime Broadcast channels (cross-device, e.g. phone →
# laptop). When absent, the app falls back to BroadcastChannel (same-device
# multi-tab only).
#
# Get these from: https://app.supabase.com → your project → Settings → API
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
